{
  "name": "lead-inbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A company-scoped lead inbox with event-based meeting history.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-vercel.mjs",
    "build:worker": "node scripts/build.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-turso.mjs",
    "generate-data": "node scripts/generate-data.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
